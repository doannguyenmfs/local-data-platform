{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "type": "stat",
      "title": "Component health",
      "id": 1,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "platform_component_up", "legendFormat": "{{component}}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN"}, "1": {"text": "UP"}}}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Watermark lag",
      "id": 2,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "pipeline_watermark_lag_seconds", "legendFormat": "{{pipeline}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "type": "timeseries",
      "title": "Staging row counts",
      "id": 3,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "staging_table_rows", "legendFormat": "{{table}}", "refId": "A"}
      ]
    },
    {
      "type": "stat",
      "title": "Kafka topic partitions",
      "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "kafka_topic_partitions", "legendFormat": "{{topic}}", "refId": "A"}
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["data-engineering", "local-platform"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "Local Data Platform Overview",
  "uid": "local-data-platform-overview",
  "version": 1
}
