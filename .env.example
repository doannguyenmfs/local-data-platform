# Copy this file to .env. Values containing `change-me` are development
# placeholders; Compose injects them into containers and Git must not track the
# resulting .env file.

# Airflow runtime/control-plane settings.
AIRFLOW_UID=50000
AIRFLOW_IMAGE=local-data-platform-airflow:3.3.0-dbt1.12
AIRFLOW_EXECUTOR=CeleryExecutor
AIRFLOW_FERNET_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
AIRFLOW_API_SECRET_KEY=change-me-airflow-api-secret
AIRFLOW_API_AUTH_JWT_SECRET=change-me-airflow-jwt-secret
AIRFLOW_LOAD_EXAMPLES=false
AIRFLOW_DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW_TIMEZONE=Asia/Ho_Chi_Minh
AIRFLOW_DAG_PROCESSOR_REFRESH_INTERVAL=30
AIRFLOW_CELERY_WORKER_CONCURRENCY=4
AIRFLOW_HOST_PORT=8080

# Dedicated Airflow metadata database; do not reuse the ecommerce database.
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=change-me-airflow-db-password
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_PORT=5432

# Ecommerce source/staging/warehouse/catalog database. HOST is used by host-side
# tools; Compose overrides it to service DNS `postgres` inside containers.
ECOMMERCE_POSTGRES_HOST=localhost
ECOMMERCE_POSTGRES_HOST_PORT=5432
ECOMMERCE_POSTGRES_USER=dataeng
ECOMMERCE_POSTGRES_PASSWORD=change-me-ecommerce-db-password
ECOMMERCE_POSTGRES_DB=ecommerce
ECOMMERCE_POSTGRES_PORT=5432

# Dedicated Debezium replication identity. The bootstrap job grants only
# CONNECT/USAGE/SELECT/REPLICATION and owns no application table.
CDC_POSTGRES_USER=cdc_reader
CDC_POSTGRES_PASSWORD=change-me-cdc-password
CDC_CONNECTOR_NAME=ecommerce-postgres-cdc-avro
CDC_TOPIC_PREFIX=ecommerce_cdc_avro
CDC_SLOT_NAME=ecommerce_cdc_avro_slot
CDC_PUBLICATION_NAME=ecommerce_cdc_publication
# Changing this starts a logically new consumer and replays retained Kafka data.
# Keep it stable for normal deploys; bump deliberately for a Silver rebuild.
CDC_CUSTOMER_CONSUMER_GROUP=customer-cdc-silver-v1
SCHEMA_REGISTRY_HOST_PORT=8084

REDIS_PORT=6379

# Explicit dbt deployment target and the schema owned by each target.
DBT_TARGET=dev
DBT_DEV_SCHEMA=dbt_dev
DBT_CI_SCHEMA=dbt_ci
DBT_PROD_SCHEMA=analytics

# Local object-store/dashboard credentials. Production requires an external
# secret manager and credential rotation rather than environment-file secrets.
MINIO_ROOT_USER=dataeng
MINIO_ROOT_PASSWORD=change-me-minio-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
